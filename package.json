{
  "name": "mirailens",
  "version": "1.2.0",
  "description": "MCP server for browser automation using MiraiLens",
  "author": {
    "name": "Mugenkyou",
    "url": "https://github.com/mugenkyou"
  },
  "contributors": [
    {
      "name": "Rohit",
      "url": "https://github.com/imrohit44"
    }
  ],
  "homepage": "https://mirailens.io",
  "bugs": "https://github.com/mirailens/mcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/mugenkyou/mcp-server-mirailens.git"
  },
  "type": "module",
  "bin": {
    "mcp-server-mirailens": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsup src/index.ts --format esm --watch",
    "inspector": "CLIENT_PORT=9001 SERVER_PORT=9002 pnpx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "commander": "^13.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "shx": "^0.4.0",
    "tsup": "^8.4.0",
    "typescript": "^5.6.2"
  }
}